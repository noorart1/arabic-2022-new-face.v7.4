<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ppv="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context="com.alburagh.alburagh.Fragments.HomeFragment">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/home_bg" />

        <ImageView
            android:id="@+id/cloud_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/home_cloud" />

        <FrameLayout
            android:id="@+id/elephant_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/home_elephant_head"
            android:clickable="true">

            <ImageView
                android:id="@+id/elephant_eye"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:src="@drawable/home_elephant_eyes" />

        </FrameLayout>

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/big_logo" />

        <ImageButton
            android:id="@+id/publication_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/publication_icon"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/music_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/music_on_button" />

        <ImageButton
            android:id="@+id/share_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/share_button"
            android:visibility="gone"/>


        <ProgressBar
            android:id="@+id/loadinghm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:max="100"
            android:progress="25"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_button" />

        <ImageButton
            android:id="@+id/account_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/subscription_button" />

        <ImageButton
            android:id="@+id/rate_button"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/rate" />


        <ImageButton
            android:id="@+id/trophy_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/trophy_button"
            android:visibility="gone"/>


        <FrameLayout
            android:id="@+id/favorite_button_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/rate_button">

            <ImageButton
                android:id="@+id/favorite_button"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:background="#00000000"
                android:scaleType="fitCenter"
                android:src="@drawable/favorite_button" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/start_button_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/startButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:scaleType="fitCenter"
                android:src="@drawable/start_button" />

        </FrameLayout>


        <RelativeLayout
            android:id="@+id/plane_drag"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/plane"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_centerInParent="true"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/plane_body"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/home_plane_body" />

                <ImageView
                    android:id="@+id/balloon"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/home_plane_balloon" />

                <ImageView
                    android:id="@+id/head_01"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/home_plane_head_01" />

                <ImageView
                    android:id="@+id/head_02"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/home_plane_head_02" />

                <ImageView
                    android:id="@+id/propeller"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/home_plane_propeller" />

                <ImageView
                    android:id="@+id/plane_eye"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/home_plane_eyelid" />



            </RelativeLayout>

        </RelativeLayout>

        <FrameLayout
            android:id="@+id/giraffe_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/home_giraffe_body">

            <FrameLayout
                android:id="@+id/giraffe_head"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:background="@drawable/home_giraffe_head">


                <ImageView
                    android:id="@+id/giraffe_eye"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:src="@drawable/home_giraffe_eye"
                    android:layout_below="@+id/giraffe_view"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true" />


            </FrameLayout>

        </FrameLayout>

    </RelativeLayout>

</RelativeLayout>
