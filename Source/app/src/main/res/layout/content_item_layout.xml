<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ppv="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clipChildren="false"
    android:rotationY="180">

    <com.alburagh.alburagh.UI.AlburaghTextView
        android:id="@+id/content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="3dp"
        android:gravity="center_horizontal"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/content_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/content_title"
        android:layout_centerHorizontal="true"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/content_border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/content_image"
        android:layout_below="@id/content_title"
        android:layout_centerHorizontal="true"
        android:scaleType="fitCenter"
        android:src="@drawable/content_border" />

    <ImageView
        android:id="@+id/free_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/free_icon"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/content_image"
        android:layout_alignTop="@id/content_image"
        android:background="#a6000000"
        android:clickable="true"
        android:visibility="visible">

        <com.filippudak.ProgressPieView.ProgressPieView
            android:id="@+id/download_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_margin="@dimen/content_item_progress_margin"
            android:text="0%"
            android:textColor="#FFF"
            android:textSize="18sp"
            ppv:ppvProgressFillType="radial"
            ppv:ppvStrokeWidth="4dp" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/content_border"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/content_item_books_margin_top"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/delete_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:padding="@dimen/content_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/delete_icon" />

        <ImageButton
            android:id="@+id/favorite_button_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:padding="@dimen/content_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/favorite_icon" />

        <ImageButton
            android:id="@+id/downloaded_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:padding="@dimen/content_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/downloaded_icon" />

    </LinearLayout>

    <ImageView
        android:id="@+id/new_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/content_image"
        android:src="@drawable/new_icon" />

</RelativeLayout>