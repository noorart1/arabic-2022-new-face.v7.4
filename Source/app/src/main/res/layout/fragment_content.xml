<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.ContentFragment">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/transition"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000" />

    <ImageView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000"
        android:scaleType="centerCrop"
        android:src="@drawable/book_splash"
        android:visibility="visible" />

    <ImageButton
        android:id="@+id/menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#00000000"
        android:scaleType="fitCenter"
        android:src="@drawable/menu_button"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/menu_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#d0000000"
        android:clickable="true" />

    <FrameLayout
        android:id="@+id/buttons_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_buttons_bg" />

    <ImageButton
        android:id="@+id/narration_button_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:background="#00000000"
        android:scaleType="fitCenter"
        android:src="@drawable/narration_on_button_over_content" />

    <ImageButton
        android:id="@+id/books_button_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:background="#00000000"
        android:scaleType="fitCenter"
        android:src="@drawable/library_button_over_content" />

    <RelativeLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/narration_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/narration_on_bmb" />

        <ImageButton
            android:id="@+id/rate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/rate_button_bmb" />

        <ImageButton
            android:id="@+id/games_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/game_button_bmb" />

        <ImageButton
            android:id="@+id/books_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/library_button_bmb" />

        <ImageButton
            android:id="@+id/email_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/email_bmb" />

        <ImageButton
            android:id="@+id/index_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:scaleType="fitCenter"
            android:src="@drawable/index_bmb" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rate_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp">

        <ImageView
            android:id="@+id/rate_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:src="@drawable/rate_text_bm_ar" />

        <LinearLayout
            android:id="@+id/rate_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rate_text"
            android:layout_marginTop="30dp"
            android:clickable="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rate_star_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rate_inactive" />

            <ImageView
                android:id="@+id/rate_star_02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rate_inactive" />

            <ImageView
                android:id="@+id/rate_star_03"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rate_inactive" />

            <ImageView
                android:id="@+id/rate_star_04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rate_inactive" />

            <ImageView
                android:id="@+id/rate_star_05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rate_inactive" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/rate_send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rate_buttons"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="#00000000"
            android:src="@drawable/rate_button_bm" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/index_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/index_pager"
            android:layout_width="fill_parent"
            android:layout_height="400dp"
            android:layout_centerHorizontal="true"
            android:overScrollMode="never">

        </androidx.viewpager.widget.ViewPager>

        <ImageButton
            android:id="@+id/index_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="#00000000"
            android:src="@drawable/next_bm" />

        <ImageButton
            android:id="@+id/index_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="#00000000"
            android:src="@drawable/prev_bm" />

    </RelativeLayout>

</RelativeLayout>